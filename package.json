{
  "name": "kinoshift",
  "productName": "Kinoshift",
  "version": "1.0.0",
  "description": "Free, offline video and audio converter for macOS and Windows. An FFmpeg GUI for MP4, MP3, WebM, GIF, and batch conversion.",
  "homepage": "https://antoinemaze.fr/kinoshift/",
  "repository": {
    "type": "git",
    "url": "https://github.com/antinmaze/kinoshift.git"
  },
  "bugs": {
    "url": "https://github.com/antinmaze/kinoshift/issues"
  },
  "keywords": [
    "video-converter", "audio-converter", "media-converter", "ffmpeg",
    "ffmpeg-gui", "batch-conversion", "audio-extraction", "video-to-gif",
    "mp4", "mp3", "webm", "hevc", "offline", "privacy", "electron", "macos", "windows"
  ],
  "main": "main.js",
  "license": "GPL-3.0-or-later",
  "author": "tonio",
  "scripts": {
    "postinstall": "node scripts/set-dev-name.js",
    "prestart": "node scripts/set-dev-name.js",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.js",
    "check-ffmpeg": "node scripts/check-ffmpeg.js",
    "dist:mac": "node scripts/fetch-ffmpeg.js mac-arm64 mac-x64 && node scripts/check-ffmpeg.js && electron-builder --mac",
    "dist:win": "node scripts/fetch-ffmpeg.js win-x64 && electron-builder --win",
    "dist": "node scripts/fetch-ffmpeg.js all && node scripts/check-ffmpeg.js && electron-builder --mac --win",
    "release:github": "bash scripts/release.sh",
    "github:check": "node scripts/github-metadata.js --check",
    "github:sync": "node scripts/github-metadata.js --apply",
    "docs:screenshots": "node scripts/capture-preview.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "build": {
    "appId": "com.tonio.kinoshift",
    "productName": "Kinoshift",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg/${os}-${arch}",
        "to": "ffmpeg"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.65.0"
  }
}
